{
    "version": 2,
    "builds": [
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/myid/access-token",
            "destination": "/api/access-token.js"
        },
        {
            "source": "/api/myid/session",
            "destination": "/api/session.js"
        },
        {
            "source": "/api/myid/user-data",
            "destination": "/api/user-data.js"
        }
    ]
}